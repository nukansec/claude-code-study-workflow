{
  "permissions": {
    "allow": [
      "Bash(pandoc *)",
      "Bash(ls *)",
      "Bash(find *)"
    ],
    "deny": [
      "Bash(find * -delete*)",
      "Bash(find * -exec *)",
      "Bash(find * -execdir *)",
      "Bash(find * -ok *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.tfvars)",
      "Read(**/*.tfvars.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/id_ecdsa*)",
      "Read(**/*credential*)",
      "Read(**/*Credential*)",
      "Read(**/secrets/**)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)"
    ]
  }
}
